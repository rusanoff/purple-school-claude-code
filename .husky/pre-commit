echo "pre-commit: ensuring Postgres is up for e2e tests..."
docker compose up -d postgres

for i in $(seq 1 30); do
  if docker compose exec -T postgres pg_isready -U "${POSTGRES_USER:-postgres}" >/dev/null 2>&1; then
    echo "pre-commit: Postgres is ready."
    break
  fi
  sleep 1
done

pnpm lint && pnpm test && pnpm test:e2e
