{
  "enabledMcpjsonServers": ["playwright"],
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(npm run test)",
      "Bash(npm run test:e2e)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npx prisma *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [ -n \"$f\" ] && [ -f \"$f\" ] && npx --no-install prettier --ignore-unknown --write \"$f\"; } >/dev/null 2>&1 || true",
            "statusMessage": "Formatting with Prettier..."
          }
        ]
      }
    ]
  }
}
